# ============================================
# IRON VAULT - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Session ---
SESSION_SECRET=your_super_secret_session_key_change_this_in_production_min_32_chars

# --- MySQL (Users & Orders) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=iron_vault

# --- MongoDB (Products & Reviews) ---
MONGODB_URI=mongodb://localhost:27017/iron_vault

# --- Security ---
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Admin Default (change after first login!) ---
ADMIN_DEFAULT_EMAIL=admin@ironvault.com
ADMIN_DEFAULT_PASSWORD=Admin@IronVault2024!
ADMIN_DEFAULT_PASSWORD=choose_a_strong_password_here
